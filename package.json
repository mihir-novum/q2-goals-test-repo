{
  "name": "q2-goals-sdlc-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "prebuild": "pnpm lint",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "configure:branch-protection": "node scripts/configure-branch-protection.mjs",
    "scan:secrets": "./.bin/betterleaks protect --staged -v",
    "scan:secrets:all": "./.bin/betterleaks detect --source . --no-git -v",
    "scan:secrets:report": "./.bin/betterleaks detect --source . --no-git -v -f json -r .betterleaks-report.json",
    "scan:vuln": "node scripts/audit-direct-dependencies.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.4",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.21.0"
}
